rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'displayName', 'bestScore', 'bestDepth'])
        && data.keys().hasOnly(['userId', 'displayName', 'photoURL', 'bestScore', 'bestDepth', 'totalRuns', 'totalKills', 'updatedAt'])
        && data.userId is string
        && data.displayName is string
        && data.displayName.size() > 0 && data.displayName.size() <= 40
        && data.bestScore is int && data.bestScore >= 0
        && data.bestDepth is int && data.bestDepth >= 1;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['userId', 'displayName', 'score', 'depth', 'kills'])
        && data.keys().hasOnly(['userId', 'displayName', 'photoURL', 'score', 'depth', 'runTimeFormatted', 'kills', 'coins', 'relicsCount', 'causeOfDeath', 'createdAt'])
        && data.userId is string
        && data.displayName is string
        && data.displayName.size() > 0 && data.displayName.size() <= 40
        && data.score is int && data.score >= 0
        && data.depth is int && data.depth >= 1
        && data.kills is int && data.kills >= 0;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isValidUser(request.resource.data);
    }

    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && isValidLeaderboardEntry(request.resource.data);
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && isValidLeaderboardEntry(request.resource.data);
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }
  }
}
